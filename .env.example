# Copy this file to .env. Leave the Shopify lines blank to run the demo shop.

DATABASE_URL="file:../data/ss.db"

# Owner sign-in. In demo mode the password defaults to squish-demo
# when OWNER_PASSWORD is empty and you are not in production.
OWNER_EMAIL="owner@sparklesquish.shop"
OWNER_PASSWORD="squish-demo"
SESSION_SECRET="change-me-to-a-long-random-string"

# Public address of this app. Shopify webhooks are sent here.
APP_URL="http://127.0.0.1:43123"

# Shopify custom app. Leave the token blank for demo mode.
SHOPIFY_STORE_DOMAIN="mw4ti4-tj.myshopify.com"
SHOPIFY_ADMIN_TOKEN=""
SHOPIFY_WEBHOOK_SECRET=""
SHOPIFY_API_VERSION="2026-10"

# Protects the 15-minute reconcile and the nightly backup on Vercel.
CRON_SECRET=""

# Optional. Without these, photos and backups stay on local disk.
# On Vercel, set an S3-compatible bucket (AWS S3 or Cloudflare R2)
# or photos and backups will disappear.
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE=""
