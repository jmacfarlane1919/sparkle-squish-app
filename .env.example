# Copy this file to .env for the demo on your computer.
# On Vercel, type these into Project → Settings → Environment Variables.
# Do not put the demo password on the live site.

# Local demo database. On Vercel this is the Neon or Vercel Postgres URL.
DATABASE_URL="file:../data/ss.db"

# Direct Postgres URL for migrations. On Neon, use the host that does not say "pooler".
# Locally you can leave this blank. On Vercel, if you only have one URL, paste it here too.
DIRECT_URL=""

# Sample catalog. Leave unset on Vercel. Set to true only if you want the sample shop.
DEMO_MODE=""

# Owner sign-in.
# On your computer, leave OWNER_PASSWORD empty and the demo password squish-demo is filled in.
# On Vercel, set both. The password must be at least 10 characters and must not be squish-demo.
# If you leave them blank on Vercel, the first visit asks you to choose them once.
OWNER_EMAIL="owner@sparklesquish.shop"
OWNER_PASSWORD=""

# Locks the sign-in cookie. At least 24 random characters.
# Make one with: openssl rand -base64 32
SESSION_SECRET=""

# Public address of this app, with no slash at the end.
# Locally: http://127.0.0.1:43123
# On Vercel: the https address Vercel gives you.
APP_URL="http://127.0.0.1:43123"

# Shopify custom app on mw4ti4-tj.myshopify.com. Leave the token blank for the demo.
SHOPIFY_STORE_DOMAIN="mw4ti4-tj.myshopify.com"
SHOPIFY_ADMIN_TOKEN=""
SHOPIFY_WEBHOOK_SECRET=""
SHOPIFY_API_VERSION="2026-10"

# Protects the scheduled Shopify sync and the nightly backup.
# Make another random string. Vercel sends it as Authorization: Bearer …
CRON_SECRET=""

# File storage. The Vercel disk is temporary, so photos, invoices, and backups
# need a private bucket. Cloudflare R2 is the free option this app speaks.
# Leave these blank on your computer. Files then stay in the storage folder.
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"
