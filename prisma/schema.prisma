// S&S Software
// The copy in git stays on SQLite so the demo runs on your computer.
// The Vercel build switches this file to PostgreSQL and runs prisma/migrations.
// The models below stay the same on both.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model BarcodeCounter {
  id         String   @id
  lastIssued String
  updatedAt  DateTime @updatedAt
}

model AppSetting {
  key   String @id
  value String
}

model Location {
  id                String           @id @default(cuid())
  name              String
  channel           String
  shopifyLocationId String?          @unique
  isDefaultReceive  Boolean          @default(false)
  stockLevels       StockLevel[]
  purchaseOrders    PurchaseOrder[]
  counts            InventoryCount[]
}

model Supplier {
  id             String          @id @default(cuid())
  name           String
  contactName    String          @default("")
  email          String          @default("")
  phone          String          @default("")
  notes          String          @default("")
  createdAt      DateTime        @default(now())
  products       Product[]
  purchaseOrders PurchaseOrder[]
  invoices       Invoice[]
  expenses       Expense[]
}

model Product {
  id               String    @id @default(cuid())
  title            String
  description      String    @default("")
  status           String    @default("active")
  shopifyProductId String?   @unique
  brand            String    @default("")
  texture          String    @default("")
  season           String    @default("")
  size             String    @default("")
  material         String    @default("")
  ageGuidance      String    @default("")
  newArrival       Boolean   @default(false)
  receivedAt       DateTime?
  categoryCode     String    @default("")
  supplierId       String?
  supplier         Supplier? @relation(fields: [supplierId], references: [id])
  variants         Variant[]
  photos           Photo[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Variant {
  id                     String               @id @default(cuid())
  productId              String
  product                Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  title                  String               @default("Default")
  variantCode            String               @default("STD")
  vendorSku              String               @default("")
  vendorBarcode          String               @default("")
  otherBarcodes          String               @default("")
  ssSku                  String               @default("")
  ssBarcode              String               @default("")
  priceCents             Int                  @default(0)
  costCents              Int?
  shopifyVariantId       String?              @unique
  shopifyInventoryItemId String?
  position               Int                  @default(0)
  levels                 StockLevel[]
  poLines                PurchaseOrderLine[]
  receiptLines           ReceiptLine[]
  countLines             InventoryCountLine[]
  saleLines              SaleLine[]
  refundLines            RefundLine[]
  labelItems             LabelQueueItem[]
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@index([ssSku])
  @@index([ssBarcode])
  @@index([vendorSku])
  @@index([vendorBarcode])
}

model StockLevel {
  id         String   @id @default(cuid())
  variantId  String
  variant    Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  available  Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([variantId, locationId])
}

model Photo {
  id            String    @id @default(cuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  role          String
  storageKey    String
  alt           String    @default("")
  contentType   String    @default("image/svg+xml")
  shopifyFileId String?
  pushedAt      DateTime?
  createdAt     DateTime  @default(now())
}

model PurchaseOrder {
  id            String              @id @default(cuid())
  number        String              @unique
  supplierId    String
  supplier      Supplier            @relation(fields: [supplierId], references: [id])
  locationId    String
  location      Location            @relation(fields: [locationId], references: [id])
  status        String              @default("draft")
  invoiceNumber String              @default("")
  notes         String              @default("")
  orderedAt     DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  lines         PurchaseOrderLine[]
  receipts      Receipt[]
  invoices      Invoice[]
}

model Invoice {
  id              String              @id @default(cuid())
  dedupeKey       String              @unique
  invoiceNumber   String
  vendorName      String
  supplierId      String?
  supplier        Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  invoiceDate     DateTime
  status          String
  totalCents      Int
  category        String              @default("")
  paidFrom        String              @default("")
  subtotalCents   Int?
  discountCents   Int?
  shippingCents   Int?
  taxCents        Int?
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?      @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  whereName       String              @default("")
  whereUrl        String              @default("")
  whereAddress    String              @default("")
  paymentAccountId String?
  paymentAccount  Account?            @relation("InvoicePayment", fields: [paymentAccountId], references: [id])
  billEntryId     String?             @unique
  paymentEntryId  String?             @unique
  attachments     InvoiceAttachment[]
  lines           InvoiceLine[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([purchaseOrderId])
  @@index([supplierId])
  @@index([invoiceDate])
}

model InvoiceAttachment {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  filename    String
  storageKey  String
  contentType String
  createdAt   DateTime @default(now())

  @@unique([invoiceId, filename])
}

model Account {
  id             String           @id @default(cuid())
  code           String           @unique
  name           String
  type           String
  contra         Boolean          @default(false)
  active         Boolean          @default(true)
  parentId       String?
  parent         Account?         @relation("AccountParent", fields: [parentId], references: [id])
  children       Account[]        @relation("AccountParent")
  systemKey      String?          @unique
  createdAt      DateTime         @default(now())
  journalLines   JournalLine[]
  expensePayments Expense[]       @relation("ExpensePayment")
  expenseLines   ExpenseLine[]
  invoicePayments Invoice[]       @relation("InvoicePayment")
  invoiceLines   InvoiceLine[]
  assets         Asset[]
  reconciliations Reconciliation[]
}

model JournalEntry {
  id        String        @id @default(cuid())
  entryDate DateTime
  memo      String        @default("")
  source    String
  sourceKey String        @unique
  createdAt DateTime      @default(now())
  lines     JournalLine[]

  @@index([entryDate])
}

model JournalLine {
  id          String       @id @default(cuid())
  entryId     String
  entry       JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account      @relation(fields: [accountId], references: [id])
  debitCents  Int          @default(0)
  creditCents Int          @default(0)
  memo        String       @default("")

  @@index([accountId])
}

model Expense {
  id               String        @id @default(cuid())
  expenseDate      DateTime
  vendorName       String
  supplierId       String?
  supplier         Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  paymentAccountId String
  paymentAccount   Account       @relation("ExpensePayment", fields: [paymentAccountId], references: [id])
  whereName        String        @default("")
  whereUrl         String        @default("")
  whereAddress     String        @default("")
  memo             String        @default("")
  totalCents       Int
  journalEntryId   String?       @unique
  createdAt        DateTime      @default(now())
  lines            ExpenseLine[]
  files            AccountingFile[]

  @@index([expenseDate])
}

model ExpenseLine {
  id          String   @id @default(cuid())
  expenseId   String
  expense     Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id])
  amountCents Int
  memo        String   @default("")
  isAsset     Boolean  @default(false)
  asset       Asset?
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account @relation(fields: [accountId], references: [id])
  amountCents Int
  memo        String  @default("")
  isAsset     Boolean @default(false)
  asset       Asset?
}

model Asset {
  id                String   @id @default(cuid())
  name              String
  purchaseDate      DateTime
  costCents         Int
  usefulLifeMonths  Int?
  depreciate        Boolean  @default(false)
  accountId         String
  account           Account  @relation(fields: [accountId], references: [id])
  expenseLineId     String?  @unique
  expenseLine       ExpenseLine? @relation(fields: [expenseLineId], references: [id])
  invoiceLineId     String?  @unique
  invoiceLine       InvoiceLine? @relation(fields: [invoiceLineId], references: [id])
  whereName         String   @default("")
  whereUrl          String   @default("")
  whereAddress      String   @default("")
  depreciatedCents  Int      @default(0)
  createdAt         DateTime @default(now())
  files             AccountingFile[]
}

model AccountingFile {
  id          String   @id @default(cuid())
  kind        String
  expenseId   String?
  expense     Expense? @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  assetId     String?
  asset       Asset?   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  filename    String
  storageKey  String
  contentType String
  createdAt   DateTime @default(now())
}

model Reconciliation {
  id                 String        @id @default(cuid())
  accountId          String
  account            Account       @relation(fields: [accountId], references: [id])
  statementDate      DateTime
  endingBalanceCents Int
  finishedAt         DateTime?
  createdAt          DateTime      @default(now())
  marks              ReconciliationMark[]
  statementLines     StatementLine[]
}

model ReconciliationMark {
  id               String         @id @default(cuid())
  reconciliationId String
  reconciliation   Reconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  journalLineId    String
  @@unique([reconciliationId, journalLineId])
}

model StatementLine {
  id               String         @id @default(cuid())
  reconciliationId String
  reconciliation   Reconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  lineDate         DateTime
  description      String         @default("")
  amountCents      Int
  journalLineId    String?
}

model CustomField {
  id        String             @id @default(cuid())
  entity    String
  label     String
  fieldType String
  options   String             @default("")
  hidden    Boolean            @default(false)
  sortOrder Int                @default(0)
  createdAt DateTime           @default(now())
  values    CustomFieldValue[]
}

model CustomFieldValue {
  id      String      @id @default(cuid())
  fieldId String
  field   CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  recordId String
  value   String      @default("")

  @@unique([fieldId, recordId])
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variantId       String?
  variant         Variant?      @relation(fields: [variantId], references: [id])
  description     String        @default("")
  qtyOrdered      Int
  qtyReceived     Int           @default(0)
  unitCostCents   Int
  receiptLines    ReceiptLine[]
}

model Receipt {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  receivedAt      DateTime      @default(now())
  note            String        @default("")
  shopifyStatus   String        @default("pending")
  lines           ReceiptLine[]
}

model ReceiptLine {
  id                  String            @id @default(cuid())
  receiptId           String
  receipt             Receipt           @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  purchaseOrderLineId String
  purchaseOrderLine   PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id])
  variantId           String?
  variant             Variant?          @relation(fields: [variantId], references: [id])
  qty                 Int
  unitCostCents       Int
  previousOnHand      Int
  previousCostCents   Int?
  newOnHand           Int
  newCostCents        Int
}

model InventoryCount {
  id          String               @id @default(cuid())
  locationId  String
  location    Location             @relation(fields: [locationId], references: [id])
  status      String               @default("open")
  startedAt   DateTime             @default(now())
  committedAt DateTime?
  note        String               @default("")
  lines       InventoryCountLine[]
}

model InventoryCountLine {
  id               String         @id @default(cuid())
  countId          String
  count            InventoryCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  variantId        String
  variant          Variant        @relation(fields: [variantId], references: [id])
  systemQtyAtStart Int
  countedQty       Int
  salesDuringCount Int            @default(0)
  commitAction     String         @default("")
  commitDetail     String         @default("")
  createdAt        DateTime       @default(now())

  @@unique([countId, variantId])
}

model SaleOrder {
  id              String     @id @default(cuid())
  shopifyOrderId  String?    @unique
  name            String
  channel         String
  locationName    String     @default("")
  processedAt     DateTime
  financialStatus String     @default("")
  cancelled       Boolean    @default(false)
  lines           SaleLine[]
  refunds         Refund[]
}

model SaleLine {
  id             String    @id @default(cuid())
  orderId        String
  order          SaleOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shopifyLineId  String?
  variantId      String?
  variant        Variant?  @relation(fields: [variantId], references: [id])
  title          String
  sku            String    @default("")
  qty            Int
  unitPriceCents Int
  unitCostCents  Int?
}

model Refund {
  id              String       @id @default(cuid())
  orderId         String
  order           SaleOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shopifyRefundId String?      @unique
  processedAt     DateTime
  lines           RefundLine[]
}

model RefundLine {
  id            String   @id @default(cuid())
  refundId      String
  refund        Refund   @relation(fields: [refundId], references: [id], onDelete: Cascade)
  variantId     String?
  variant       Variant? @relation(fields: [variantId], references: [id])
  title         String
  qty           Int
  amountCents   Int
  unitCostCents Int?
}

model LabelPrintJob {
  id         String           @id @default(cuid())
  printedAt  DateTime         @default(now())
  size       String
  labelCount Int
  undoneAt   DateTime?
  snapshot   String           @default("[]")
  items      LabelQueueItem[]
}

model LabelQueueItem {
  id           String         @id @default(cuid())
  variantId    String
  variant      Variant        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  source       String
  sourceKey    String         @unique
  receivedOn   String
  suggestedQty Int
  printQty     Int
  status       String         @default("needs_labels")
  printedAt    DateTime?
  printedCount Int            @default(0)
  printJobId   String?
  printJob     LabelPrintJob? @relation(fields: [printJobId], references: [id])
  createdAt    DateTime       @default(now())

  @@index([status, receivedOn])
}

model AuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  feature   String
  action    String
  mode      String
  summary   String
  payload   String   @default("")
  result    String   @default("")
}

model FeatureFlag {
  key         String  @id
  enabled     Boolean @default(false)
  label       String
  description String  @default("")
}

model SyncRun {
  id         String    @id @default(cuid())
  kind       String
  status     String
  detail     String    @default("")
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
}

model WebhookEvent {
  id        String   @id @default(cuid())
  webhookId String?  @unique
  topic     String
  status    String
  detail    String   @default("")
  createdAt DateTime @default(now())
}
